<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wg_bg_dark" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="10dp">
    <ImageView android:id="@+id/dot" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/wg_dot" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="8dp" android:orientation="vertical">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:text="Veil" android:textColor="#FFFFFFFF" android:fontFamily="@font/montserrat_semibold" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="12sp" android:text="@string/wg_off" android:textColor="#FFA8AAB2" android:fontFamily="@font/montserrat_medium" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/btn" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="44dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/wg_btn_accent" android:textSize="14sp" android:text="@string/wg_connect" android:textColor="#FF0B0B0C" android:fontFamily="@font/montserrat_semibold" android:singleLine="true" />
</LinearLayout>
