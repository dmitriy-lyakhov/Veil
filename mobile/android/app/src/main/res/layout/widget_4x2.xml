<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wg_bg_dark" android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:id="@+id/ring" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/wg_ring_off_dark">
        <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/wg_power" android:contentDescription="@null" />
        <ProgressBar android:id="@+id/spin" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateTint="#FFFF393D" android:visibility="gone" />
    </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/wg_dot" android:contentDescription="@null" />
                <TextView android:id="@+id/state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="13sp" android:fontFamily="@font/montserrat_semibold" android:singleLine="true" />
            </LinearLayout>
            <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="18sp" android:fontFamily="@font/montserrat_semibold" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="12sp" android:fontFamily="@font/montserrat_medium" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="top" android:src="@drawable/ic_mark" android:contentDescription="@null" />
    </LinearLayout>
    <LinearLayout android:id="@+id/chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/chip0" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"  android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:background="@drawable/wg_chip_dark">
            <TextView android:id="@+id/chip0_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="@font/montserrat_semibold" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/chip0_proto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="11sp" android:fontFamily="@font/montserrat_medium" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/chip1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:background="@drawable/wg_chip_dark">
            <TextView android:id="@+id/chip1_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="@font/montserrat_semibold" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/chip1_proto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="11sp" android:fontFamily="@font/montserrat_medium" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/chip2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:background="@drawable/wg_chip_dark">
            <TextView android:id="@+id/chip2_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="@font/montserrat_semibold" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/chip2_proto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="11sp" android:fontFamily="@font/montserrat_medium" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
