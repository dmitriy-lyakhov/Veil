# Настройки контейнеров Veil (docker compose). Скопируйте в .env и поправьте при необходимости.
# Пустые значения — по умолчанию. Большинство параметров действует только при ПЕРВОМ запуске
# (пока в томе нет конфигурации); адреса для клиентов можно менять и потом.

# ---------- общее ----------
# Публичные адреса сервера, которые попадут в конфиги клиентов. Пусто — определить через api.ipify.org.
VEIL_PUBLIC_IPV4=
VEIL_PUBLIC_IPV6=
# Адрес (IP или домен) для WireGuard, AmneziaWG, OpenVPN и IPsec; пусто — IPv4, иначе IPv6.
VEIL_HOST=
# 0 — не обращаться к внешним сервисам за адресом (тогда задайте адреса выше)
VEIL_DETECT_IP=1
# Регистр и тег образов (если собираете и публикуете их сами)
VEIL_IMAGE_REGISTRY=veil
VEIL_IMAGE_TAG=latest

# ---------- Veil ----------
VEIL_HTTPS_PORT=443
VEIL_HTTP_PORT=80
VEIL_SITE_LANG=ru
# Маскировка под чужой сайт (SNI), например ya.ru; пусто — выключена
VEIL_FRONT=
# Домен для сайта-прикрытия и сертификата Let's Encrypt
VEIL_DOMAIN=
# Имя первого клиента; пусто — не создавать
VEIL_FIRST_CLIENT=client

# ---------- WireGuard ----------
WG_PORT=51820
WG_SUBNET=10.8.1.0/24
WG_FIRST_CLIENT=client

# ---------- AmneziaWG ----------
AWG_PORT=51821
AWG_SUBNET=10.9.1.0/24
AWG_FIRST_CLIENT=client
AWG_JC=4
AWG_JMIN=10
AWG_JMAX=50

# ---------- OpenVPN ----------
OVPN_PORT=1194
# udp или tcp
OVPN_PROTO=udp
OVPN_SUBNET=10.9.0.0/24
OVPN_FIRST_CLIENT=client

# ---------- IPsec/IKEv2 ----------
IPSEC_POOL=10.10.0.0/24
# дополнительные имена/адреса в сертификат сервера (через пробел)
IPSEC_EXTRA_SANS=
IPSEC_FIRST_CLIENT=client

# ---------- IPv6-подсети сетей Docker (ULA) ----------
VEIL_NET_IPV6=fd76:6569:6c00:1::/64
WG_NET_IPV6=fd76:6569:6c00:2::/64
AWG_NET_IPV6=fd76:6569:6c00:3::/64
OVPN_NET_IPV6=fd76:6569:6c00:4::/64
IPSEC_NET_IPV6=fd76:6569:6c00:5::/64

# ---------- Админ-панель ----------
# admin — поднять веб-панель в отдельном контейнере veil-admin; пусто — без панели (/admin отвечает 404)
COMPOSE_PROFILES=admin
VEIL_ADMIN=container
# Доступ панели к Docker для страницы «Протоколы» (= права root на хосте). Пусто — нет доступа.
# VEIL_ADMIN_DOCKER_SOCK=/var/run/docker.sock
